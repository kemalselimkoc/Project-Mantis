<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>ProjectMantis</RootNamespace>
    <AssemblyName>ProjectMantis</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <ApplicationIcon>assets\mantis.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Runtime" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Windows.Foundation"><HintPath>$(WINDIR)\System32\WinMetadata\Windows.Foundation.winmd</HintPath><Private>False</Private></Reference>
    <Reference Include="Windows.Media"><HintPath>$(WINDIR)\System32\WinMetadata\Windows.Media.winmd</HintPath><Private>False</Private></Reference>
    <Reference Include="Windows.Graphics"><HintPath>$(WINDIR)\System32\WinMetadata\Windows.Graphics.winmd</HintPath><Private>False</Private></Reference>
    <Reference Include="Windows.Storage"><HintPath>$(WINDIR)\System32\WinMetadata\Windows.Storage.winmd</HintPath><Private>False</Private></Reference>
    <Reference Include="Windows.Globalization"><HintPath>$(WINDIR)\System32\WinMetadata\Windows.Globalization.winmd</HintPath><Private>False</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="obj\**;dist\**;release\**" />
    <Resource Include="assets\mantis-logo.png" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
